# Django Settings
DEBUG=True
SECRET_KEY=change-in-production-avestellar-finance-super-secret-key-32chars
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://avestellar:avestellar@127.0.0.1:5433/avestellar_finance

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Default Currency & Financial Precision
DEFAULT_CURRENCY=KES
DEFAULT_DECIMAL_PLACES=2

# MauzoPilot Integration (Disabled until active credentials configured)
MAUZOPILOT_ENABLED=False
MAUZOPILOT_BASE_URL=https://api.mauzopilot.com/v1
MAUZOPILOT_API_KEY=
MAUZOPILOT_WEBHOOK_SECRET=

# Webhook Security
WEBHOOK_DEFAULT_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=5

# AI Financial Engine Configuration
AI_ASSISTANT_ENABLED=False
AI_ASSISTANT_PROVIDER=none
AI_ASSISTANT_API_KEY=
