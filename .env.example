# Django Settings
# DJANGO_ENV selects the configuration profile: development | test | staging |
# production. Any other value is rejected at startup. `ENVIRONMENT` is still
# accepted as a legacy alias when DJANGO_ENV is unset.
# DEBUG must be False for any shared/staging/production deployment. Leave True
# only for a local machine. DEBUG defaults to False when unset, and staging /
# production always enable strict validation regardless of DEBUG.
DJANGO_ENV=development
DEBUG=True
# REQUIRED (staging): a unique 50+ character secret. There is NO built-in
# SECRET_KEY fallback: an empty value refuses to boot. Never reuse this
# placeholder — staging/production reject known placeholder values.
SECRET_KEY=replace-with-a-unique-50-character-secret
# REQUIRED (staging): real hostnames, comma separated.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# REQUIRED (staging): a real PostgreSQL URL. These values are nonfunctional
# placeholders, not working credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Default Currency & Financial Precision
DEFAULT_CURRENCY=KES
DEFAULT_DECIMAL_PLACES=2

# MauzoPilot Integration (Disabled until active credentials configured)
MAUZOPILOT_ENABLED=False
MAUZOPILOT_BASE_URL=https://api.mauzopilot.com/v1
MAUZOPILOT_API_KEY=
MAUZOPILOT_WEBHOOK_SECRET=

# Webhook Security
WEBHOOK_DEFAULT_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=5

# AI Financial Engine Configuration
AI_ASSISTANT_ENABLED=False
AI_ASSISTANT_PROVIDER=none
AI_ASSISTANT_API_KEY=

# CORS / CSRF (only needed if the browser calls this API cross-origin; the
# Next.js app normally proxies /api/v1 same-origin). List exact origins, comma
# separated, including scheme. Never relies on DEBUG.
# ALLOW_PERMISSIVE_CORS must stay False: wildcard / null origins are rejected
# in staging and production unless this is explicitly set, and doing so is an
# audit finding, not a shortcut.
ALLOW_PERMISSIVE_CORS=False
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# TLS / reverse proxy (staging). SECURE_SSL_REDIRECT and HSTS apply when
# DEBUG=False. Set USE_X_FORWARDED_PROTO=True behind a TLS-terminating proxy.
USE_X_FORWARDED_PROTO=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Cache for distributed rate limiting + shared token state.
# REQUIRED for multi-worker staging: without it throttling is per-process and
# therefore not reliable across web dynos/workers.
# Accepted schemes: redis://, rediss://, unix://  (remote plaintext is rejected
# in staging/production - use rediss://). Leave empty for local development.
REDIS_URL=
# Set True on multi-worker deployments: a missing REDIS_URL then aborts startup
# instead of silently degrading to per-process throttling.
CACHE_REQUIRE_SHARED=False
# Documented override for a trusted private network (strict profiles only).
ALLOW_INSECURE_CACHE_TRANSPORT=False
CACHE_SOCKET_TIMEOUT_SECONDS=3
CACHE_MAX_CONNECTIONS=100
# A cache that is unreachable fails closed: throttled endpoints return 5xx.
# Verify a real shared cache before claiming distributed throttling:
#   python scripts/check_shared_cache.py --require-shared

# Database connection pooling. Keep DB_CONN_MAX_AGE=0 when fronting PgBouncer in
# transaction pooling mode; raise it only for direct/dedicated connections.
DB_CONN_MAX_AGE=0
DB_CONNECT_TIMEOUT_SECONDS=10

# Request / upload ceilings (bytes).
#   DATA_UPLOAD_MAX_MEMORY_SIZE  - non-file request bodies
#   FILE_UPLOAD_MAX_MEMORY_SIZE  - in-memory threshold before spooling to disk
#   MAX_STATEMENT_UPLOAD_BYTES   - accepted statement file size (matches the
#                                  frontend's 15 MB guard in statements.tsx)
# The reverse proxy (nginx/client_max_body_size) must also allow this size.
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
MAX_STATEMENT_UPLOAD_BYTES=15728640

# Authentication abuse throttling (documented, distinct per sensitive endpoint).
THROTTLE_LOGIN_RATE=20/min
THROTTLE_REGISTER_RATE=10/hour
